    "Keeping the Mac awake — click to quit, right click for options": {
      "comment": "Tooltip of the status bar icon.",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не засне — націсніце, каб выйсці, правая кнопка — параметры"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac няма да заспива — щракнете, за да излезете, десен бутон за опции"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nebude usínat — klikněte pro ukončení, pravé tlačítko otevře volby"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'en holdes vågen — klik for at slutte, højreklik for indstillinger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac bleibt wach — klicken zum Beenden, Rechtsklick für Optionen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Mac μένει ξύπνιος — κάντε κλικ για έξοδο, δεξί κλικ για επιλογές"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac se mantiene despierto: haz clic para salir, clic derecho para las opciones"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac pysyy hereillä — lopeta klikkaamalla, oikea klikkaus avaa valinnat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac reste éveillé — cliquez pour quitter, clic droit pour les options"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac जगा रहेगा — बंद करने के लिए क्लिक करें, विकल्पों के लिए राइट क्लिक करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mac ébren marad — kattints a kilépéshez, jobb kattintás a beállításokhoz"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac tetap terjaga — klik untuk keluar, klik kanan untuk opsi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac resta sveglio — fai clic per uscire, clic destro per le opzioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac をスリープさせません — クリックで終了、右クリックでオプション"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 깨어 있게 유지 — 클릭하면 종료, 오른쪽 클릭하면 옵션"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Macen holdes våken — klikk for å avslutte, høyreklikk for valg"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Mac blijft wakker — klik om te stoppen, rechtsklik voor opties"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nie zaśnie — kliknij, aby zakończyć, prawy przycisk otwiera opcje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac ficará acordado — clique para sair, clique com o botão direito para as opções"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac fica acordado — clique para sair, clique com o botão direito para as opções"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-ul rămâne treaz — clic pentru a ieși, clic dreapta pentru opțiuni"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не заснёт — нажмите, чтобы выйти, правая кнопка — параметры"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nebude zaspávať — kliknite na ukončenie, pravé tlačidlo otvorí voľby"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Macen hålls vaken — klicka för att avsluta, högerklicka för alternativ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac uyanık kalır — çıkmak için tıklayın, seçenekler için sağ tıklayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не засинатиме — клацніть, щоб вийти, права кнопка — параметри"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac sẽ không ngủ — bấm để thoát, bấm chuột phải để xem tùy chọn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 Mac 唤醒 — 点按退出，右键点按打开选项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 Mac 喚醒 — 點一下結束，右鍵點一下開啟選項"
          }
        }
      }
    },
    "Prevent disk idle sleep": {
      "comment": "Menu item, caffeinate -m",
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не спыняць дыск пры прастоі"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без заспиване на диска при бездействие"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabránit uspání disku při nečinnosti"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhindr harddisken i at gå på vågeblus"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhezustand der Festplatte verhindern"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποτροπή αδρανοποίησης δίσκου"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitar el reposo del disco"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Estä levyn lepotila"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêcher la mise en veille du disque"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निष्क्रिय होने पर डिस्क को स्लीप में जाने से रोकें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne aludjon el a lemez tétlenség esetén"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cegah disk tidur saat menganggur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisci lo stop del disco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクのアイドルスリープを防ぐ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 대기 모드 방지"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindre at disken går i dvale"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorkom dat de schijf in sluimerstand gaat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapobiegaj usypianiu dysku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedir que o disco durma por inatividade"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedir a suspensão do disco por inatividade"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împiedică adormirea discului"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не останавливать диск при простое"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabrániť uspaniu disku pri nečinnosti"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindra hårddisken från att gå till vila"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskin uykuya geçmesini engelle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зупиняти диск при простої"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngăn đĩa ngủ khi rảnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止磁盘闲置休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防止磁碟閒置睡眠"
          }
        }
      }
